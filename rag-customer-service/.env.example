QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3.7-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSION=1024
# Rerank uses QWEN_API_KEY and the fixed qwen3-rerank model.
QWEN_RERANK_URL=https://maas.qianwenaiapi.com/compatible-api/v1/reranks
SQLITE_PATH=data/app.db
CHROMA_PATH=data/chroma
UPLOADS_PATH=data/uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=7
RETRIEVAL_SCORE_THRESHOLD=0.5
# The threshold above applies only to legacy retrieval without a reranker.
# Production uses reranked Top-K followed by semantic evidence validation.
